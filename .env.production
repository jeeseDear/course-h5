# 生产环境（npm run build 默认使用该环境）
# npm run dev:prod   → 本地以生产配置启动
# npm run build      → 产出生产包

# 环境标识，业务代码用 import.meta.env.VITE_APP_ENV 读取
VITE_APP_ENV=production
VITE_APP_ENV_NAME=生产环境

# 部署子路径：决定 vite base 与 router 的 history base
VITE_BASE_PATH=/course/

# 后端接口地址（当前页面全是本地 mock，接入真实接口时改这里）
VITE_API_BASE_URL=/course/api
