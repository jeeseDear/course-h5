# FAT 测试环境（本地 dev 默认使用该环境）
# npm run dev        → fat
# npm run build:fat  → 产出 fat 包

# 环境标识，业务代码用 import.meta.env.VITE_APP_ENV 读取
VITE_APP_ENV=fat
VITE_APP_ENV_NAME=测试环境

# 部署子路径：决定 vite base 与 router 的 history base
VITE_BASE_PATH=/course/

# 后端接口地址：dev 时由 vite proxy 去掉 /course 前缀转发到 Python 服务
VITE_API_BASE_URL=/course/api

# 本地开发代理目标（server/main.py）
VITE_API_PROXY_TARGET=http://127.0.0.1:8200
